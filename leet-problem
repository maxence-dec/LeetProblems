#!/usr/bin/env bash
set -euo pipefail

declare -A STATUS
STATUS[0]="new"
STATUS[1]="in-progress"
STATUS[2]="solved"
STATUS[3]="abandoned"

usage() {
    echo "Usage: leet-problem <leetcode-url> <lang...>"
    echo "       leet-problem https://leetcode.com/problems/two-sum/ c cpp"
    echo "Languages: c  cpp  python  csharp  mysql"
    exit 1
}

new_problem() {
    [[ $# -lt 2 ]] && usage

    URL="$1"
    shift
    LANGS=("$@")

    REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    SCRIPTS_DIR="$REPO_ROOT/scripts"
    META="$REPO_ROOT/.meta/problems.json"

    # --- extract slug from URL ---
    SLUG=$(echo "$URL" | sed -E 's|https?://leetcode\.com/problems/([^/]+)/?.*|\1|')
    if [[ "$SLUG" == "$URL" ]]; then
        echo "[leet-problem] Could not extract slug from URL: $URL" >&2
        exit 1
    fi

    echo "[leet-problem] Slug: $SLUG"
    echo "[leet-problem] Languages: ${LANGS[*]}"

    # --- environment check ---
    "$SCRIPTS_DIR/check_env.sh"

    # --- scaffold problem directory ---
    "$SCRIPTS_DIR/scaffold.sh" "$SLUG" "${LANGS[@]}"

    # --- update .meta/problems.json ---
    CACHE_FILE="/tmp/lc_cache/${SLUG}.json"

    TITLE=$(jq -r '.title' "$CACHE_FILE")
    DIFFICULTY=$(jq -r '.difficulty' "$CACHE_FILE")
    TOPICS=$(jq -r '[.topicTags[].name]' "$CACHE_FILE")

    LANG_JSON=$(printf '%s\n' "${LANGS[@]}" | jq -R . | jq -s .)

    JSON_CONTENT=$(cat "$META")
    ALREADY=$(echo "$JSON_CONTENT" | jq --arg slug "$SLUG" 'map(select(.slug == $slug)) | length')

    if [[ "$ALREADY" -eq 0 ]]; then
        echo "$JSON_CONTENT" | jq \
            --arg slug "$SLUG" \
            --arg title "$TITLE" \
            --arg difficulty "$DIFFICULTY" \
            --argjson topics "$TOPICS" \
            --argjson languages "$LANG_JSON" \
            '. + [{slug: $slug, title: $title, difficulty: $difficulty, topics: $topics, languages: $languages, status: "in-progress"}]' \
            > "$META.tmp" && mv "$META.tmp" "$META"
        echo "[leet-problem] Added to problems.json"
    else
        echo "[leet-problem] Slug already in problems.json — skipping JSON update"
    fi

    # --- regenerate root README ---
    "$SCRIPTS_DIR/gen_readme_root.sh"

    echo ""
    echo "[leet-problem] Done."
    echo "  Problem dir : $REPO_ROOT/problems/$SLUG/"
    echo "  Next steps  : edit problems/$SLUG/README.md, write solution, run 'make test'"
}

status_update(){
    [[ $# -lt 1 ]] && usage

    NEW_STATUS="${STATUS[$1]:-}"
    [[ -z "$NEW_STATUS" ]] && { echo "Unknown status code: $2"; exit 1; }

    SLUG=$(basename "$(pwd)")

    REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    SCRIPTS_DIR="$REPO_ROOT/scripts"
    META="$REPO_ROOT/.meta/problems.json"

    JSON_CONTENT=$(cat "$META")
    ALREADY=$(echo "$JSON_CONTENT" | jq --arg slug "$SLUG" 'map(select(.slug == $slug)) | length')

    if [[ "$ALREADY" -ne 0 ]]; then
        OLD_STATUS=$(echo "$JSON_CONTENT" | jq --arg slug "$SLUG" 'map(select(.slug == $slug) | .status)')
        echo "$JSON_CONTENT" | jq \
            --arg slug "$SLUG" \
            --arg status "$NEW_STATUS" \
            '(.[] | select(.slug == $slug) | .status) |= $status' \
            > "$META.tmp" && mv "$META.tmp" "$META"
        echo "[leet-problem] Update to problems.json, $SLUG from $OLD_STATUS to $NEW_STATUS"
    else
        echo "[leet-problem] Slug $SLUG no found in problems.json — skipping JSON update"
    fi
}


[[ $# -lt 1 ]] && usage

FUNCTION_ARG="$1"
shift

case "$FUNCTION_ARG" in
        new)
            echo "[leet-problem] Adding new problem"
            new_function "$@"
            ;;
        status)
            echo "[leet-problem] Updating $(basename "$(pwd)") status"
            status_update "$@"
            ;;
        *)
            echo "[scaffold] Unknown argument"
            exit 1
            ;;
    esac